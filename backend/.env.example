# --- core ---
ENVIRONMENT=development            # set to "production" to enforce a real JWT secret
DATABASE_URL=sqlite:///./safesphere.db
# production: postgresql+psycopg://safesphere:safesphere@db:5432/safesphere
JWT_SECRET=change-me-to-a-long-random-string
PUBLIC_BASE_URL=http://localhost:8000   # used in the links texted to contacts

# --- escalation policy (minutes) ---
GRACE_MINUTES=10          # ETA passes -> user nudged -> wait this long before alerting contacts
SECOND_LEVEL_MINUTES=15   # after contacts alerted -> escalate to everyone
SCHEDULER_ENABLED=true
SCHEDULER_INTERVAL_SECONDS=30
LOCATION_RETENTION_HOURS=24

# --- SMS (without a provider, messages are only printed to the server log and reported as NOT delivered) ---
FAST2SMS_API_KEY=         # India: Fast2SMS Dev API key (secret: set it in the host dashboard)
TWILIO_ACCOUNT_SID=
TWILIO_AUTH_TOKEN=
TWILIO_FROM_NUMBER=

# --- Email alerts over HTTPS (Brevo free plan; Render's free plan blocks SMTP) ---
BREVO_API_KEY=            # secret: set it in the host dashboard, never commit it
EMAIL_FROM=               # a sender address you verified in Brevo
EMAIL_FROM_NAME=SafeSphere
